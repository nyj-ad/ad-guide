 "sources": {
  "DECREE": {
   "name": "옥외광고물 등의 관리와 옥외광고산업 진흥에 관한 법률 시행령",
   "id_text": "대통령령 제36054호, 2026. 1. 27. 타법개정",
   "effective": "2026-01-27",
   "url": "https://www.law.go.kr/LSW/lsInfoP.do?lsId=004242",
   "level": "primary",
   "how": "국가법령정보센터 화면에서 공포번호·시행일 확인(2026-11-11). 제4조·제5조 내용은 2026-11-03 구축 시 확인."
  },
  "GG_EASYLAW": {
   "name": "경기도 옥외광고물 등의 관리와 옥외광고산업 진흥에 관한 조례 (법제처 찾기쉬운 생활법령정보 「옥외광고물(경기도)」 해설)",
   "id_text": "법제처 생활법령 2026. 10. 15. 기준",
   "effective": null,
   "url": "https://easylaw.go.kr/CSP/CnpClsOrdinMain.laf?popMenu=ov&areaCsmOrdinSeq=1129&ccfNo=1&cciNo=2&cnpClsNo=1",
   "level": "official-secondary",
   "how": "법제처 생활법령 해설 본문에서 수치와 근거 조문 표기 확인(2026-11-11). 조례 원문(국가법령정보센터 자치법규)과의 직접 대조는 하지 못함."
  },
  "GOSI_2025_3": {
   "name": "남양주시 옥외광고물 등의 특정구역 지정 및 표시제한·완화 고시",
   "id_text": "경기도 고시 제2025-3호, 2025. 1. 8.",
   "effective": "2025-01-08",
   "url": "https://www.nyj.go.kr/www/selectBbsNttView.do?bbsNo=35&key=2406&nttNo=499044",
   "level": "primary",
   "how": "담당자 보유 고시문 원본 파일(hwp) 전문을 읽어 확인(2026-11-11). 구역 목록 표와 위치도 그림은 기계 판독하지 못함."
  },
  "NYJ_ORD": {
   "name": "남양주시 옥외광고물 등의 관리와 옥외광고산업 진흥에 관한 조례",
   "id_text": "조례 제2488호, 2025. 12. 29. 시행",
   "effective": "2025-12-29",
   "url": "https://www.law.go.kr/ordinInfoP.do?ordinSeq=2099101",
   "level": "partial",
   "how": "수수료(제25조, 별표 3·4)만 2026-11-03에 확인. 표시방법 관련 조항은 확인하지 못함."
  },
  "PILOT_ZONE": {
   "name": "광고물등 정비시범구역 지정 및 표시방법 고시(진접읍·퇴계원읍 / 화도읍·금곡동·진접읍)",
   "id_text": "미확인",
   "effective": null,
   "url": "https://www.nyj.go.kr/www/selectBbsNttList.do?key=2406&bbsNo=35",
   "level": "unverified",
   "how": "원본 파일은 보유하고 있으나 이번 작업에서 내용을 분석하지 않음."
  }
 },
